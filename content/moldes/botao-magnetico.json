  "demo": {
    "html": "<div class=\"w\"><button class=\"b\">Vamos conversar →</button></div>",
    "css": ".w{display:grid;place-items:center;height:100vh}\n.b{font:600 1rem var(--font);padding:1rem 1.6rem;border-radius:99px;border:0;background:var(--fg);color:var(--bg);animation:mag 3s cubic-bezier(.34,1.56,.64,1) infinite}\n@keyframes mag{0%,100%{transform:none}25%{transform:translate(10px,-6px)}50%{transform:translate(-8px,5px)}75%{transform:translate(4px,4px)}}",
    "height": 220,
    "fonts": [],
    "hover": true,
    "dark": false
  },
  "code": [],
  "kind": "motion",
  "trigger": "hover",
  "duration_ms": 400,
  "easing": "spring(stiffness 300, damping 20)",
  "stagger_ms": 0,
  "props": [
    "x",
    "y"
  ],
  "reduced_motion": "Desligar; botão fica parado.",
  "snippet": "const x = useSpring(0, { stiffness: 300, damping: 20 }); const y = useSpring(0, { stiffness: 300, damping: 20 });\n<motion.button style={{ x, y }}\n  onPointerMove={(e) => { const r = e.currentTarget.getBoundingClientRect(); x.set((e.clientX - r.left - r.width / 2) * 0.3); y.set((e.clientY - r.top - r.height / 2) * 0.3); }}\n  onPointerLeave={() => { x.set(0); y.set(0); }}>Vamos conversar</motion.button>"
}
